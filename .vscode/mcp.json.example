{
  "inputs": [
    { "type": "promptString", "id": "fd-key", "description": "Financial Datasets API key", "password": true }
  ],
  "servers": {
    "market-intel": {
      "type": "stdio",
      "command": "uv",
      "args": ["--directory", "${workspaceFolder}/mcp-server-main", "run", "server.py"],
      "env": { "FINANCIAL_DATASETS_API_KEY": "${input:fd-key}" }
    }
  }
}
